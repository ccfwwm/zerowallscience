{
  "name": "zerowall-science",
  "version": "0.4.12",
  "private": true,
  "description": "ZeroWall Science — local-first, model-agnostic AI research workbench for macOS, Windows and Linux.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @zerowall/desktop dev",
    "build": "pnpm --filter @zerowall/desktop build",
    "test": "pnpm --filter @zerowall/desktop test",
    "test:brand": "node --test scripts/check-brand-contract.test.mjs && node scripts/check-brand-contract.mjs",
    "test:version": "node --test scripts/check-version-contract.test.mjs && node scripts/check-version-contract.mjs",
    "test:agents": "node scripts/validate-agents.mjs",
    "typecheck": "pnpm --filter @zerowall/desktop typecheck",
    "lint": "pnpm --filter @zerowall/desktop lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0",
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
