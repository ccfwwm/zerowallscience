{
  "name": "zerowallscience",
  "version": "4.3.13",
  "description": "ZeroWall Science local-first scientific research workbench.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": "24.9.0" },
  "scripts": {
    "plugins:generate": "node tools/plugins/generate-workspaces.mjs",
    "profiles:generate": "tsx tools/profiles/generate.ts",
    "profiles:check": "tsx tools/profiles/generate.ts --check",
    "dsh:inventory": "node tools/dsh/inventory.mjs",
    "dsh:verify": "node tools/dsh/verify.mjs",
    "dsh:runtime:closure": "node tools/dsh/runtime-closure.mjs",
    "dsh:client:graph": "pnpm --filter @deepseek-ai/dsh-root run verify-module-graph",
    "dsh:build:host": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm --filter @deepseek-ai/dsh-root run build:lib:host",
    "dsh:build:client": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm --filter @deepseek-ai/dsh-root run build:lib:client",
    "dsh:build:web": "pnpm --filter @deepseek-ai/dsh-root run build:web",
    "dsh:build:zerowall": "node tools/dsh/build-zerowall.mjs",
    "store:bundle": "pnpm --filter @zerowallscience/research-store run bundle",
    "plugins:typert": "node tools/plugins/generate-typert.mjs",
    "plugins:bundle": "pnpm plugins:typert && pnpm --filter @zerowallscience/plugin-* run bundle && node tools/plugins/inline-css.mjs",
    "plugins:typecheck": "pnpm --filter @zerowallscience/plugin-* run typecheck",
    "plugins:test": "pnpm --filter @zerowallscience/plugin-* run test",
    "resources:prepare": "node tools/packaging/prepare-resources.mjs",
    "audit:claude-science": "node tools/integration/audit-claude-science.mjs",
    "native:rebuild": "pnpm rebuild electron esbuild node-pty sharp koffi",
    "runtime:prepare": "pnpm native:rebuild && node tools/packaging/prepare-runtime.mjs",
    "build": "pnpm plugins:generate && pnpm profiles:generate && pnpm dsh:verify && pnpm dsh:build:zerowall && pnpm store:bundle && pnpm plugins:bundle && pnpm dsh:runtime:closure && pnpm runtime:prepare && pnpm resources:prepare && pnpm --filter @zerowallscience/desktop run build",
    "dev": "pnpm plugins:generate && pnpm profiles:generate && pnpm plugins:bundle && pnpm --filter @zerowallscience/desktop run dev",
    "lint": "pnpm --filter @deepseek-ai/dsh-root run lint:contracts-ready",
    "typecheck": "pnpm dsh:verify && pnpm --filter @deepseek-ai/dsh-root run typecheck && pnpm --filter @zerowallscience/research-store run bundle && pnpm plugins:typecheck && pnpm --filter @zerowallscience/desktop run typecheck",
    "test": "node --test tests/contracts/*.test.mjs && node --test tests/security/*.test.mjs && pnpm --filter @zerowallscience/research-store test && pnpm plugins:test && pnpm --filter @zerowallscience/desktop test",
    "test:plugins": "pnpm plugins:test",
    "test:dsh:alpha1": "pnpm dsh:verify && pnpm --filter @deepseek-ai/dsh-root exec vitest run --config vitest.web.config.ts apps/web/tests/shipped-composition.e2e.ts",
    "test:dsh:composition": "pnpm test:dsh:alpha1",
    "test:dsh:desktop-compat": "pnpm --filter @zerowallscience/plugin-desktop-compat test",
    "test:wechat": "pnpm --filter @zerowallscience/plugin-wechat test",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:integration": "pnpm exec vitest run tools/integration/mcp-environment.test.ts",
    "security:audit": "node tools/security/audit-runtime.mjs",
    "audit:runtime": "node desktop/scripts/verify-packaged-runtime.mjs --audit-source",
    "verify:package": "node desktop/scripts/verify-packaged-runtime.mjs",
    "smoke:electron": "pnpm --filter @zerowallscience/desktop run test:e2e",
    "smoke:host": "node tools/packaging/smoke-host.mjs",
    "smoke:directory-picker": "node tools/packaging/smoke-directory-picker.mjs",
    "smoke:update": "node tools/release/smoke-update.mjs",
    "release:metadata": "node tools/release/generate-windows-metadata.mjs",
    "release:verify-local": "node tools/release/smoke-update.mjs",
    "release:publish:stable": "node scripts/publish-qiniu.mjs",
    "mcp:environment:build": "node tools/release/build-mcp-environment.mjs",
    "mcp:environment:publish": "node scripts/publish-mcp-environment.mjs",
    "release:verify:stable": "node scripts/verify-qiniu.mjs",
    "package:dir": "pnpm build && pnpm --filter @zerowallscience/desktop run package:dir",
    "package:win": "pnpm package:stable:win",
    "package:stable:win": "pnpm build && pnpm --filter @zerowallscience/desktop run package:stable:win",
    "package:mac:x64": "pnpm build && pnpm --filter @zerowallscience/desktop run package:mac:x64",
    "package:mac:arm64": "pnpm build && pnpm --filter @zerowallscience/desktop run package:mac:arm64",
    "package:stable:mac:x64": "pnpm build && pnpm --filter @zerowallscience/desktop run package:stable:mac:x64",
    "package:stable:mac:arm64": "pnpm build && pnpm --filter @zerowallscience/desktop run package:stable:mac:arm64"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "0.22.2",
    "cross-env": "10.1.0",
    "jsdom": "^26.1.0",
    "qiniu": "^7.12.0",
    "tsx": "^4.22.4",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
