    {
      "id": "r.faerskit.analyze",
      "public_tool": "r_faerskit",
      "category": "r_faerskit",
      "summary": "Run a parameterized FAERS pharmacovigilance analysis (AFun/BFun/CFun/EFun/FFun/HFun/IFun/KFun/DDI/DDIALL/Concomitant_Medication_Analysis/BFun_upgrade1/BFun_upgrade2/disproportionality_analysis_for_top50_drug) on the remote ClickHouse database as an asynchronous job. Signal-detection results are produced as CSV files. Results are written to the project workspace and retrieved with r_get_job_manifest then r_get_job_result or r_download_file. Requires confirm=true.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "description": "ZeroWall project id"
          },
          "fun": {
            "type": "string",
            "enum": [
              "AFun",
              "BFun",
              "CFun",
              "EFun",
              "FFun",
              "HFun",
              "IFun",
              "KFun",
              "DDI",
              "DDIALL",
              "Concomitant_Medication_Analysis",
              "BFun_upgrade1",
              "BFun_upgrade2",
              "disproportionality_analysis_for_top50_drug"
            ],
            "description": "Which faerskit function to run"
          },
          "drug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Single drug name (AFun/CFun/EFun/HFun)"
          },
          "ptname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Target PT (BFun/BFun_upgrade1/BFun_upgrade2/CFun/top50)"
          },
          "drug1": {
            "$ref": "#/properties/drug",
            "description": "First drug (DDI/DDIALL/Concomitant/top50 drug1)"
          },
          "drug2": {
            "$ref": "#/properties/drug",
            "description": "Second drug (DDI/DDIALL/Concomitant/top50 drug2)"
          },
          "drug3": {
            "$ref": "#/properties/drug",
            "description": "Third drug (Concomitant/top50 drug3)"
          },
          "drug4": {
            "$ref": "#/properties/drug",
            "description": "Fourth drug (Concomitant/top50 drug4)"
          },
          "drug5": {
            "$ref": "#/properties/drug",
            "description": "Fifth drug (top50 only)"
          },
          "drug6": {
            "$ref": "#/properties/drug",
            "description": "Sixth drug (top50 only)"
          },
          "drug7": {
            "$ref": "#/properties/drug",
            "description": "Seventh drug (top50 only)"
          },
          "drug8": {
            "$ref": "#/properties/drug",
            "description": "Eighth drug (top50 only)"
          },
          "drug9": {
            "$ref": "#/properties/drug",
            "description": "Ninth drug (top50 only)"
          },
          "drug10": {
            "$ref": "#/properties/drug",
            "description": "Tenth drug (top50 only)"
          },
          "edrug1": {
            "$ref": "#/properties/drug",
            "description": "Excluded drug (DDI/DDIALL only)"
          },
          "edrug2": {
            "$ref": "#/properties/drug",
            "description": "Second excluded drug (DDI/DDIALL only)"
          },
          "drug_PS": {
            "$ref": "#/properties/drug",
            "description": "Primary-suspect drug (FFun)"
          },
          "drug_concomitant": {
            "$ref": "#/properties/drug",
            "description": "Concomitant drug (FFun)"
          },
          "drug_A": {
            "$ref": "#/properties/drug",
            "description": "Drug A (IFun)"
          },
          "drug_B": {
            "$ref": "#/properties/drug",
            "description": "Drug B (IFun)"
          },
          "primaryid": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "maxItems": 100,
            "description": "Optional FAERS primaryid values (AFun/CFun)"
          },
          "drug_exclusion": {
            "$ref": "#/properties/primaryid",
            "description": "Drug exclusion list (AFun only)"
          },
          "drug_route": {
            "$ref": "#/properties/primaryid",
            "description": "Route values such as \"ORAL\" (BFun only)"
          },
          "unit": {
            "type": "string",
            "enum": [
              "pair",
              "case"
            ],
            "description": "Counting unit for AFun/CFun/FFun/IFun/DDI/DDIALL/Concomitant; omit for other functions"
          },
          "age": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Inclusive age range in years, e.g. [18, 75]"
          },
          "gender": {
            "type": "string",
            "maxLength": 20,
            "description": "Gender filter, e.g. \"F\" or \"M\""
          },
          "weight": {
            "$ref": "#/properties/age",
            "description": "Inclusive weight range"
          },
          "agent": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "$ref": "#/properties/primaryid"
              }
            ],
            "description": "FAERS OCCP_COD, e.g. \"CN\" (consumer), \"MD\" (physician), \"PH\" (pharmacist)"
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "$ref": "#/properties/primaryid"
              }
            ],
            "description": "Reporter country code, e.g. \"CN\", \"US\""
          },
          "drugEffect": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "$ref": "#/properties/primaryid"
              }
            ],
            "description": "Drug role code: \"PS\", \"SS\", \"C\", \"I\""
          },
          "year": {
            "$ref": "#/properties/age",
            "description": "Inclusive getdatayear code range: 41=2004Q1, 141=2014Q1, 244=2024Q4. Not calendar years; confirm database coverage first."
          },
          "illnesses": {
            "$ref": "#/properties/primaryid",
            "description": "Optional vector of strings"
          },
          "illnesses_exclusion": {
            "$ref": "#/properties/illnesses"
          },
          "pregnancy": {
            "type": "boolean"
          },
          "pregnancy_exclusion": {
            "type": "boolean"
          },
          "drug_exclusion_from_alldata": {
            "$ref": "#/properties/illnesses"
          },
          "database": {
            "type": "string",
            "maxLength": 100,
            "description": "ClickHouse database name, e.g. \"druginfo\" or \"2026Q1\""
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 14400000,
            "default": 3600000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Output directory relative to the job result dir; defaults to faerskit/<fun>/<timestamp>"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "project_id",
          "fun",
          "confirm"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "effects": "execute",
      "query_allowed": false,
      "execution": "async_or_cached",
      "confirmation_fields": [
        "confirm"
      ],
      "requires_confirmation": true,
      "lifecycle": {
        "id_fields": [
          "job_id",
          "id"
        ],
        "argument": "job_id",
        "status": "r.get.job",
        "cancel": "r.cancel.job",
        "manifest": "r.get.job.manifest",
        "log": "r.get.job.log"
      },
      "availability": "requires_runtime_check",
      "verification": "registered",
      "output": "Submission with remote identifier; status and manifest are separate operations."
    }
  ]
}
