            "type": "string",
            "minLength": 1
          },
          "factor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "design": {
            "type": "object",
            "properties": {
              "batch": {
