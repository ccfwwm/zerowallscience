  "operations": [
    {
      "id": "r.upload.transfer",
      "public_tool": "r_files",
      "category": "r_files",
      "summary": "Host resumable upload: start/status/chunk/finish, at most 4 MiB per chunk and 20 GiB per file. SHA-256 checked before atomic commit; existing destinations are not overwritten.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$",
            "description": "ZeroWall project id"
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "status",
              "chunk",
              "finish"
            ]
          },
          "transfer_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string",
            "maxLength": 1024,
            "default": "",
            "description": "Path relative to the project root; absolute paths and symbolic links are rejected"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 21474836480
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "data_base64": {
            "type": "string",
            "maxLength": 5592416
          },
          "confirm": {
            "type": "boolean",
            "default": false,
            "description": "Must be true for file writes, destructive actions, code execution, and package changes"
          }
        },
        "required": [
          "project_id",
          "action",
          "transfer_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "effects": "write",
      "query_allowed": false,
      "execution": "sync",
      "confirmation_fields": [
        "confirm"
      ],
      "requires_confirmation": true,
      "lifecycle": null,
      "availability": "requires_runtime_check",
      "verification": "registered",
      "output": "Immediate structured result; no background task is implied."
    },
