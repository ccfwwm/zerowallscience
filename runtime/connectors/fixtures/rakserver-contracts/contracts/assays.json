{
  "domain": "assays",
  "version": "1.0.0",
  "description": "BioAssay Ontology, ChEMBL, PubChem, BindingDB, BRENDA, SABIO-RK assay contracts",
  "tools": [
    {"name": "bioassay_ontology_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["assays"], "properties": {"assays": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "bioassay_ontology_get", "inputSchema": {"type": "object", "required": ["bao_id"], "properties": {"bao_id": {"type": "string", "pattern": "^BAO_\\d+$"}}}, "outputSchema": {"type": "object", "required": ["bao_id"], "properties": {"bao_id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "chembl_search_assays_v2", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["assays"], "properties": {"assays": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "chembl_get_assay_v2", "inputSchema": {"type": "object", "required": ["chembl_id"], "properties": {"chembl_id": {"type": "string", "pattern": "^CHEMBL\\d+$"}}}, "outputSchema": {"type": "object", "required": ["chembl_id"], "properties": {"chembl_id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "pubchem_bioassay_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["assays"], "properties": {"assays": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 5}},
    {"name": "pubchem_get_bioassay", "inputSchema": {"type": "object", "required": ["aid"], "properties": {"aid": {"type": "integer"}}}, "outputSchema": {"type": "object", "required": ["aid", "data"], "properties": {"aid": {"type": "integer"}, "data": {"type": "object"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 5}},
    {"name": "bindingdb_search", "inputSchema": {"type": "object", "properties": {"target": {"type": ["string", "null"]}, "ligand": {"type": ["string", "null"]}}}, "outputSchema": {"type": "object", "required": ["results"], "properties": {"results": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "brenda_enzyme_search", "inputSchema": {"type": "object", "required": ["ec_number"], "properties": {"ec_number": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"}}}, "outputSchema": {"type": "object", "required": ["ec_number", "data"], "properties": {"ec_number": {"type": "string"}, "data": {"type": "object"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "sabio_rk_kinetics", "inputSchema": {"type": "object", "properties": {"enzyme": {"type": ["string", "null"]}, "organism": {"type": ["string", "null"]}}}, "outputSchema": {"type": "object", "required": ["reactions"], "properties": {"reactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}}
  ]
}
