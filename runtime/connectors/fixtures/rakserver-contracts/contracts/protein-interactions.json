{
  "domain": "protein-interactions",
  "version": "1.0.0",
  "description": "STRING, BioGRID, IntAct, MINT, DIP, HPRD protein interaction contracts",
  "tools": [
    {"name": "string_search_interactions", "inputSchema": {"type": "object", "required": ["protein"], "properties": {"protein": {"type": "string"}, "species": {"type": "integer", "default": 9606}}}, "outputSchema": {"type": "object", "required": ["interactions"], "properties": {"interactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "string_get_network", "inputSchema": {"type": "object", "required": ["proteins"], "properties": {"proteins": {"type": "array", "items": {"type": "string"}}, "species": {"type": "integer", "default": 9606}}}, "outputSchema": {"type": "object", "required": ["network"], "properties": {"network": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "biogrid_search_interactions", "inputSchema": {"type": "object", "required": ["gene_name"], "properties": {"gene_name": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["interactions"], "properties": {"interactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "biogrid_get_interaction", "inputSchema": {"type": "object", "required": ["interaction_id"], "properties": {"interaction_id": {"type": "integer"}}}, "outputSchema": {"type": "object", "required": ["interaction_id"], "properties": {"interaction_id": {"type": "integer"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "intact_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["interactions"], "properties": {"interactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "intact_get_interaction", "inputSchema": {"type": "object", "required": ["ac"], "properties": {"ac": {"type": "string", "pattern": "^EBI-\\d+$"}}}, "outputSchema": {"type": "object", "required": ["ac"], "properties": {"ac": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "mint_search_interactions", "inputSchema": {"type": "object", "required": ["protein"], "properties": {"protein": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["interactions"], "properties": {"interactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "dip_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["interactions"], "properties": {"interactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "hprd_search_interactions", "inputSchema": {"type": "object", "required": ["gene_symbol"], "properties": {"gene_symbol": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["interactions"], "properties": {"interactions": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}}
  ]
}
