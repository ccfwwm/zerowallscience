{
  "domain": "pathways",
  "version": "1.0.0",
  "description": "Reactome, KEGG, WikiPathways biological pathway contracts",
  "tools": [
    {
      "name": "reactome_pathway_search",
      "description": "Search Reactome pathways by query",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "species": { "type": "string", "default": "Homo sapiens" },
          "max_results": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stId", "displayName"],
              "properties": {
                "stId": { "type": "string" },
                "displayName": { "type": "string" },
                "species": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 2 }
    },
    {
      "name": "reactome_get_pathway",
      "description": "Fetch Reactome pathway details",
      "inputSchema": {
        "type": "object",
        "required": ["pathway_id"],
        "properties": {
          "pathway_id": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["stId", "displayName"],
        "properties": {
          "stId": { "type": "string" },
          "displayName": { "type": "string" },
          "summation": { "type": "array" },
          "hasEvent": { "type": "array" }
        }
      },
      "errorCases": [{ "case": "not_found", "expectedError": { "type": "NotFoundError" }}],
      "rateLimits": { "requestsPerSecond": 2 }
    },
    {
      "name": "reactome_analysis_species",
      "description": "Analyze gene/protein list against Reactome",
      "inputSchema": {
        "type": "object",
        "required": ["identifiers"],
        "properties": {
          "identifiers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "species": { "type": "string", "default": "Homo sapiens" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["pathways"],
        "properties": {
          "pathways": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stId": { "type": "string" },
                "name": { "type": "string" },
                "pValue": { "type": "number" },
                "fdr": { "type": "number" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "reactome_diagram",
      "description": "Get pathway diagram URL",
      "inputSchema": {
        "type": "object",
        "required": ["pathway_id"],
        "properties": {
          "pathway_id": { "type": "string" },
          "format": { "type": "string", "enum": ["png", "svg"], "default": "png" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["diagram_url"],
        "properties": {
          "pathway_id": { "type": "string" },
          "diagram_url": { "type": "string" }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 2 }
    },
    {
      "name": "kegg_list_pathways",
      "description": "List KEGG pathways for organism",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organism": { "type": "string", "default": "hsa" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["pathways"],
        "properties": {
          "pathways": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry_id": { "type": "string" },
                "definition": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 0.1, "note": "KEGG: 10 requests per minute" }
    },
    {
      "name": "kegg_get_pathway",
      "description": "Fetch KEGG pathway details",
      "inputSchema": {
        "type": "object",
        "required": ["pathway_id"],
        "properties": {
          "pathway_id": { "type": "string", "pattern": "^\\w+\\d{5}$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["entry", "name"],
        "properties": {
          "entry": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "genes": { "type": "array" }
        }
      },
      "errorCases": [{ "case": "not_found", "expectedError": { "type": "NotFoundError" }}],
      "rateLimits": { "requestsPerSecond": 0.1 }
    },
    {
      "name": "kegg_find_genes",
      "description": "Search KEGG genes",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "organism": { "type": "string", "default": "hsa" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "gene_id": { "type": "string" },
                "definition": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 0.1 }
    },
    {
      "name": "wikipathways_search",
      "description": "Search WikiPathways",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "species": { "type": "string", "default": "Homo sapiens" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["result"],
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "species": { "type": "string" },
                "revision": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "wikipathways_get_pathway",
      "description": "Fetch WikiPathways pathway",
      "inputSchema": {
        "type": "object",
        "required": ["pathway_id"],
        "properties": {
          "pathway_id": { "type": "string", "pattern": "^WP\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["pathway"],
        "properties": {
          "pathway": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "organism": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      },
      "errorCases": [{ "case": "not_found", "expectedError": { "type": "NotFoundError" }}],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "biocyc_search_pathways",
      "description": "Search BioCyc pathways",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "organism": { "type": "string", "default": "HUMAN" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frameid": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "biocyc_get_pathway",
      "description": "Fetch BioCyc pathway details",
      "inputSchema": {
        "type": "object",
        "required": ["pathway_id"],
        "properties": {
          "pathway_id": { "type": "string" },
          "organism": { "type": "string", "default": "HUMAN" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["pathway"],
        "properties": {
          "pathway": {
            "type": "object",
            "properties": {
              "frameid": { "type": "string" },
              "common_name": { "type": "string" },
              "reactions": { "type": "array" }
            }
          }
        }
      },
      "errorCases": [{ "case": "not_found", "expectedError": { "type": "NotFoundError" }}],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "jaspar_search_matrices",
      "description": "Search JASPAR transcription factor matrices",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tf_name": { "type": ["string", "null"] },
          "species": { "type": "string", "default": "Homo sapiens" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["matrices"],
        "properties": {
          "matrices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "matrix_id": { "type": "string" },
                "name": { "type": "string" },
                "species": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "jaspar_get_matrix",
      "description": "Fetch JASPAR matrix details",
      "inputSchema": {
        "type": "object",
        "required": ["matrix_id"],
        "properties": {
          "matrix_id": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["matrix_id", "name"],
        "properties": {
          "matrix_id": { "type": "string" },
          "name": { "type": "string" },
          "matrix": { "type": "object" }
        }
      },
      "errorCases": [{ "case": "not_found", "expectedError": { "type": "NotFoundError" }}],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "encode_tfbs",
      "description": "Search ENCODE TFBS peaks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tf": { "type": ["string", "null"] },
          "cell_type": { "type": ["string", "null"] },
          "assembly": { "type": "string", "default": "GRCh38" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["datasets"],
        "properties": {
          "datasets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accession": { "type": "string" },
                "target": { "type": "string" },
                "biosample": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "unibind_tfbs",
      "description": "Search UniBind TFBS data",
      "inputSchema": {
        "type": "object",
        "required": ["tf_name"],
        "properties": {
          "tf_name": { "type": "string" },
          "species": { "type": "string", "default": "Homo_sapiens" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "collection_id": { "type": "string" },
                "tf": { "type": "string" },
                "dataset": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    },
    {
      "name": "rfam_families_search",
      "description": "Search Rfam RNA families",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rfam_acc": { "type": "string" },
                "rfam_id": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": { "requestsPerSecond": 1 }
    }
  ]
}
