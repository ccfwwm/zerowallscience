{
  "domain": "transcriptomics",
  "version": "1.0.0",
  "description": "RNA-seq, microarray, transcriptomics data contracts",
  "tools": [
    {"name": "geo_search_series", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["series"], "properties": {"series": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 3}},
    {"name": "geo_get_series", "inputSchema": {"type": "object", "required": ["gse_id"], "properties": {"gse_id": {"type": "string", "pattern": "^GSE\d+$"}}}, "outputSchema": {"type": "object", "required": ["gse_id"], "properties": {"gse_id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 3}},
    {"name": "encode_rna_seq_experiments", "inputSchema": {"type": "object", "properties": {"cell_type": {"type": ["string", "null"]}, "organism": {"type": ["string", "null"]}}}, "outputSchema": {"type": "object", "required": ["experiments"], "properties": {"experiments": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "encode_get_rna_files", "inputSchema": {"type": "object", "required": ["experiment_id"], "properties": {"experiment_id": {"type": "string", "pattern": "^ENCSR\d+[A-Z]+$"}}}, "outputSchema": {"type": "object", "required": ["files"], "properties": {"files": {"type": "array"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "gtex_tissue_expression", "inputSchema": {"type": "object", "required": ["gene_id"], "properties": {"gene_id": {"type": "string", "pattern": "^ENSG\d+$"}}}, "outputSchema": {"type": "object", "required": ["gene_id", "tissues"], "properties": {"gene_id": {"type": "string"}, "tissues": {"type": "array"}}}, "errorCases": [{"case": "gene_not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "refine_bio_search_experiments", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["experiments"], "properties": {"experiments": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "refine_bio_get_experiment", "inputSchema": {"type": "object", "required": ["accession"], "properties": {"accession": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["accession"], "properties": {"accession": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "recount3_search_projects", "inputSchema": {"type": "object", "properties": {"organism": {"type": ["string", "null"]}}}, "outputSchema": {"type": "object", "required": ["projects"], "properties": {"projects": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "recount3_get_gene_counts", "inputSchema": {"type": "object", "required": ["project_id"], "properties": {"project_id": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["project_id", "counts"], "properties": {"project_id": {"type": "string"}, "counts": {"type": "object"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}}
  ]
}
