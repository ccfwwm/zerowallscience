{
  "domain": "chemistry",
  "version": "1.0.0",
  "description": "PubChem, ChEBI, chemical compound search contracts",
  "tools": [
    {
      "name": "pubchem_search_compounds",
      "description": "Search PubChem by name, SMILES, or InChI",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": ["string", "null"] },
          "search_type": {
            "type": "string",
            "enum": ["name", "smiles", "inchi", "formula"],
            "default": "name"
          },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "query": { "type": "string" },
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cid", "iupac_name"],
              "properties": {
                "cid": { "type": "integer" },
                "iupac_name": { "type": "string" },
                "molecular_formula": { "type": "string" },
                "molecular_weight": { "type": "number" },
                "canonical_smiles": { "type": "string" },
                "inchi": { "type": "string" },
                "inchikey": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "condition": "query is null or empty",
          "expectedError": {
            "type": "ValueError",
            "message": "query required"
          }
        },
        {
          "case": "invalid_smiles",
          "condition": "search_type is smiles but query invalid",
          "expectedError": {
            "type": "ValueError",
            "message": "Invalid SMILES"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 5,
        "note": "PubChem PUG REST: 5 req/s, 400 req/min"
      }
    },
    {
      "name": "pubchem_get_compound",
      "description": "Fetch complete PubChem compound record by CID",
      "inputSchema": {
        "type": "object",
        "required": ["cid"],
        "properties": {
          "cid": { "type": "integer", "minimum": 1 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["cid", "molecular_formula"],
        "properties": {
          "cid": { "type": "integer" },
          "iupac_name": { "type": "string" },
          "molecular_formula": { "type": "string" },
          "molecular_weight": { "type": "number" },
          "canonical_smiles": { "type": "string" },
          "isomeric_smiles": { "type": "string" },
          "inchi": { "type": "string" },
          "inchikey": { "type": "string" },
          "xlogp": { "type": ["number", "null"] },
          "exact_mass": { "type": "number" },
          "monoisotopic_mass": { "type": "number" },
          "tpsa": { "type": ["number", "null"] },
          "complexity": { "type": ["number", "null"] },
          "h_bond_donor_count": { "type": "integer" },
          "h_bond_acceptor_count": { "type": "integer" },
          "rotatable_bond_count": { "type": "integer" },
          "heavy_atom_count": { "type": "integer" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "condition": "CID does not exist",
          "expectedError": {
            "type": "NotFoundError",
            "message": "CID not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 5
      }
    },
    {
      "name": "pubchem_similar",
      "description": "Find similar compounds by structure similarity",
      "inputSchema": {
        "type": "object",
        "required": ["smiles"],
        "properties": {
          "smiles": { "type": "string" },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "query_smiles": { "type": "string" },
          "threshold": { "type": "number" },
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cid", "similarity_score"],
              "properties": {
                "cid": { "type": "integer" },
                "similarity_score": { "type": "number" },
                "canonical_smiles": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "invalid_smiles",
          "expectedError": {
            "type": "ValueError",
            "message": "Invalid SMILES"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 5
      }
    },
    {
      "name": "chebi_search_entities",
      "description": "Search ChEBI chemical entities",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "search_category": {
            "type": "string",
            "enum": ["ALL", "CHEBI_NAME", "CHEBI_ID", "FORMULA", "SMILES"],
            "default": "ALL"
          },
          "max_results": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "query": { "type": "string" },
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chebi_id", "chebi_ascii_name"],
              "properties": {
                "chebi_id": { "type": "string" },
                "chebi_ascii_name": { "type": "string" },
                "definition": { "type": "string" },
                "star": { "type": "integer" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1,
        "note": "ChEBI SOAP/REST: polite usage"
      }
    },
    {
      "name": "chebi_get_entity",
      "description": "Fetch complete ChEBI entity by ID",
      "inputSchema": {
        "type": "object",
        "required": ["chebi_id"],
        "properties": {
          "chebi_id": { "type": "string", "pattern": "^CHEBI:\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["chebi_id", "chebi_ascii_name"],
        "properties": {
          "chebi_id": { "type": "string" },
          "chebi_ascii_name": { "type": "string" },
          "definition": { "type": "string" },
          "smiles": { "type": ["string", "null"] },
          "inchi": { "type": ["string", "null"] },
          "inchikey": { "type": ["string", "null"] },
          "formula": { "type": ["string", "null"] },
          "mass": { "type": ["number", "null"] },
          "charge": { "type": ["integer", "null"] },
          "monoisotopic_mass": { "type": ["number", "null"] },
          "synonyms": { "type": "array", "items": { "type": "string" } },
          "ontology_parents": { "type": "array" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError",
            "message": "ChEBI ID not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "zinc_search_compounds",
      "description": "Search ZINC database for purchasable compounds",
      "inputSchema": {
        "type": "object",
        "properties": {
          "smiles": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] },
          "molecular_weight_min": { "type": ["number", "null"] },
          "molecular_weight_max": { "type": ["number", "null"] },
          "logp_min": { "type": ["number", "null"] },
          "logp_max": { "type": ["number", "null"] },
          "purchasable_only": { "type": "boolean", "default": true },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["zinc_id", "smiles"],
              "properties": {
                "zinc_id": { "type": "string" },
                "smiles": { "type": "string" },
                "molecular_weight": { "type": "number" },
                "logp": { "type": "number" },
                "purchasable": { "type": "boolean" },
                "reactive": { "type": "boolean" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "condition": "All search parameters are null",
          "expectedError": {
            "type": "ValueError",
            "message": "At least one search parameter required"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "zinc_get_substance",
      "description": "Fetch ZINC compound details",
      "inputSchema": {
        "type": "object",
        "required": ["zinc_id"],
        "properties": {
          "zinc_id": { "type": "string", "pattern": "^ZINC\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["zinc_id", "smiles"],
        "properties": {
          "zinc_id": { "type": "string" },
          "smiles": { "type": "string" },
          "molecular_weight": { "type": "number" },
          "logp": { "type": "number" },
          "hbd": { "type": "integer" },
          "hba": { "type": "integer" },
          "tpsa": { "type": "number" },
          "purchasable": { "type": "boolean" },
          "vendors": { "type": "array" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "chembl_search_compounds",
      "description": "Search ChEMBL molecules",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": ["string", "null"] },
          "smiles": { "type": ["string", "null"] },
          "similarity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["molecule_chembl_id"],
              "properties": {
                "molecule_chembl_id": { "type": "string" },
                "pref_name": { "type": ["string", "null"] },
                "canonical_smiles": { "type": "string" },
                "molecular_weight": { "type": "number" },
                "max_phase": { "type": "integer" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "expectedError": {
            "type": "ValueError",
            "message": "query or smiles required"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "chembl_get_compound",
      "description": "Fetch ChEMBL molecule details",
      "inputSchema": {
        "type": "object",
        "required": ["chembl_id"],
        "properties": {
          "chembl_id": { "type": "string", "pattern": "^CHEMBL\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["molecule_chembl_id"],
        "properties": {
          "molecule_chembl_id": { "type": "string" },
          "pref_name": { "type": ["string", "null"] },
          "canonical_smiles": { "type": "string" },
          "molecular_weight": { "type": "number" },
          "max_phase": { "type": "integer" },
          "molecule_type": { "type": "string" },
          "first_approval": { "type": ["integer", "null"] },
          "oral": { "type": ["boolean", "null"] },
          "parenteral": { "type": ["boolean", "null"] },
          "topical": { "type": ["boolean", "null"] }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "chembl_search_targets",
      "description": "Search ChEMBL targets",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "target_type": {
            "type": ["string", "null"],
            "enum": [null, "PROTEIN", "CELL-LINE", "TISSUE", "ORGANISM"]
          },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target_chembl_id", "pref_name"],
              "properties": {
                "target_chembl_id": { "type": "string" },
                "pref_name": { "type": "string" },
                "target_type": { "type": "string" },
                "organism": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "chembl_get_target",
      "description": "Fetch ChEMBL target details",
      "inputSchema": {
        "type": "object",
        "required": ["target_chembl_id"],
        "properties": {
          "target_chembl_id": { "type": "string", "pattern": "^CHEMBL\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["target_chembl_id", "pref_name"],
        "properties": {
          "target_chembl_id": { "type": "string" },
          "pref_name": { "type": "string" },
          "target_type": { "type": "string" },
          "organism": { "type": "string" },
          "tax_id": { "type": "integer" },
          "target_components": { "type": "array" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "chembl_search_assays",
      "description": "Search ChEMBL bioassays",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_chembl_id": { "type": ["string", "null"] },
          "assay_type": {
            "type": ["string", "null"],
            "enum": [null, "B", "F", "A", "P", "T"]
          },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["assay_chembl_id"],
              "properties": {
                "assay_chembl_id": { "type": "string" },
                "description": { "type": "string" },
                "assay_type": { "type": "string" },
                "assay_organism": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "expectedError": {
            "type": "ValueError",
            "message": "At least one filter required"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    }
  ]
}
