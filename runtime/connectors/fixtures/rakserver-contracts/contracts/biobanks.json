    {"name": "uk_biobank_data_showcase", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["fields"], "properties": {"fields": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "uk_biobank_get_field", "inputSchema": {"type": "object", "required": ["field_id"], "properties": {"field_id": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["field_id"], "properties": {"field_id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "biolincc_search_studies", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["studies"], "properties": {"studies": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
