    {"name": "biosample_get", "inputSchema": {"type": "object", "required": ["accession"], "properties": {"accession": {"type": "string", "pattern": "^SAM[NED]?\\d+$"}}}, "outputSchema": {"type": "object", "required": ["accession"], "properties": {"accession": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 3}}
  ]
