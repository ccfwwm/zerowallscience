    {"name": "arxiv_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "max_results": {"type": "integer", "default": 10}}}, "outputSchema": {"type": "object", "required": ["entries"], "properties": {"entries": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
