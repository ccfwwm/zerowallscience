    {"name": "semantic_scholar_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "limit": {"type": "integer", "default": 10}}}, "outputSchema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 10}},
    {"name": "semantic_scholar_get_paper", "inputSchema": {"type": "object", "required": ["paper_id"], "properties": {"paper_id": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["paperId"], "properties": {"paperId": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 10}},
    {"name": "crossref_search_works", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "rows": {"type": "integer", "default": 20}}}, "outputSchema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 50}},
    {"name": "crossref_get_work", "inputSchema": {"type": "object", "required": ["doi"], "properties": {"doi": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["DOI"], "properties": {"DOI": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 50}},
