{
  "domain": "variants",
  "version": "1.0.0",
  "description": "ClinVar, dbSNP, gnomAD, ExAC, COSMIC, OMIM, HGMD variant database contracts",
  "tools": [
    {"name": "clinvar_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["variants"], "properties": {"variants": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 3}},
    {"name": "clinvar_get_variant", "inputSchema": {"type": "object", "required": ["variant_id"], "properties": {"variant_id": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 3}},
    {"name": "dbsnp_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["snps"], "properties": {"snps": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 3}},
    {"name": "dbsnp_get_snp", "inputSchema": {"type": "object", "required": ["rs_id"], "properties": {"rs_id": {"type": "string", "pattern": "^rs\\d+$"}}}, "outputSchema": {"type": "object", "required": ["rs_id"], "properties": {"rs_id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 3}},
    {"name": "gnomad_variant_lookup", "inputSchema": {"type": "object", "required": ["variant"], "properties": {"variant": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["variant"], "properties": {"variant": {"type": "object"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 2}},
    {"name": "gnomad_gene_variants", "inputSchema": {"type": "object", "required": ["gene_symbol"], "properties": {"gene_symbol": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["variants"], "properties": {"variants": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 2}},
    {"name": "cosmic_search_mutations", "inputSchema": {"type": "object", "required": ["gene_name"], "properties": {"gene_name": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["mutations"], "properties": {"mutations": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "cosmic_get_mutation", "inputSchema": {"type": "object", "required": ["cosmic_id"], "properties": {"cosmic_id": {"type": "string", "pattern": "^COSV?\\d+$"}}}, "outputSchema": {"type": "object", "required": ["cosmic_id"], "properties": {"cosmic_id": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "omim_search", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}}, "outputSchema": {"type": "object", "required": ["entries"], "properties": {"entries": {"type": "array"}}}, "errorCases": [], "rateLimits": {"requestsPerSecond": 1}},
    {"name": "omim_get_entry", "inputSchema": {"type": "object", "required": ["mim_number"], "properties": {"mim_number": {"type": "string", "pattern": "^\\d{6}$"}}}, "outputSchema": {"type": "object", "required": ["mim_number"], "properties": {"mim_number": {"type": "string"}}}, "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}], "rateLimits": {"requestsPerSecond": 1}}
  ]
}
