{
  "domain": "proteomics",
  "version": "1.0.0",
  "description": "UniProt, InterPro, protein annotation contracts",
  "tools": [
    {
      "name": "uniprot_search_proteins",
      "description": "Search UniProt by gene, organism, keyword",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": ["string", "null"] },
          "organism": { "type": ["string", "null"] },
          "reviewed": { "type": ["boolean", "null"], "description": "Swiss-Prot only if true" },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["n_records_returned", "records"],
        "properties": {
          "query": { "type": "string" },
          "n_records_returned": { "type": "integer" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["accession", "id"],
              "properties": {
                "accession": { "type": "string" },
                "id": { "type": "string" },
                "protein_name": { "type": "string" },
                "gene_name": { "type": "string" },
                "organism": { "type": "string" },
                "length": { "type": "integer" },
                "reviewed": { "type": "boolean" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "condition": "query and organism both null",
          "expectedError": {
            "type": "ValueError",
            "message": "query or organism required"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1,
        "note": "UniProt REST: polite usage, no published limit"
      }
    },
    {
      "name": "uniprot_get_protein",
      "description": "Fetch complete UniProt entry by accession",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^[OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2}$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "sequence"],
        "properties": {
          "accession": { "type": "string" },
          "id": { "type": "string" },
          "protein_name": { "type": "string" },
          "gene_name": { "type": "string" },
          "organism": { "type": "string" },
          "sequence": { "type": "string" },
          "length": { "type": "integer" },
          "mass": { "type": "integer" },
          "function": { "type": "string" },
          "subcellular_location": { "type": "array" },
          "domains": { "type": "array" },
          "reviewed": { "type": "boolean" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError",
            "message": "Accession not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "interpro_search_entries",
      "description": "Search InterPro protein families and domains",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": ["string", "null"] },
          "type": {
            "type": ["string", "null"],
            "enum": [null, "family", "domain", "site", "repeat"]
          },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["count", "results"],
        "properties": {
          "count": { "type": "integer" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["accession", "name", "type"],
              "properties": {
                "accession": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "short_name": { "type": "string" },
                "member_databases": { "type": "array" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "expectedError": {
            "type": "ValueError",
            "message": "query required"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "interpro_get_entry",
      "description": "Fetch InterPro entry details",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^IPR\\d{6}$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "name", "type"],
        "properties": {
          "accession": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "member_databases": { "type": "array" },
          "go_terms": { "type": "array" },
          "protein_count": { "type": "integer" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "interpro_protein_matches",
      "description": "Find InterPro matches for a protein sequence",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "description": "UniProt accession" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "matches"],
        "properties": {
          "accession": { "type": "string" },
          "length": { "type": "integer" },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["accession", "name", "locations"],
              "properties": {
                "accession": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "locations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "integer" },
                      "end": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "pfam_search_families",
      "description": "Search Pfam protein families",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "max_records": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pfam_accession", "pfam_id"],
              "properties": {
                "pfam_accession": { "type": "string" },
                "pfam_id": { "type": "string" },
                "description": { "type": "string" },
                "clan": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "pfam_get_family",
      "description": "Fetch Pfam family details",
      "inputSchema": {
        "type": "object",
        "required": ["pfam_id"],
        "properties": {
          "pfam_id": { "type": "string", "pattern": "^PF\\d{5}$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["pfam_accession", "pfam_id"],
        "properties": {
          "pfam_accession": { "type": "string" },
          "pfam_id": { "type": "string" },
          "description": { "type": "string" },
          "comment": { "type": "string" },
          "seed_count": { "type": "integer" },
          "full_count": { "type": "integer" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "prosite_search_patterns",
      "description": "Search PROSITE patterns and profiles",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "type": { "type": ["string", "null"], "enum": [null, "pattern", "profile"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accession": { "type": "string" },
                "id": { "type": "string" },
                "description": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "prosite_get_pattern",
      "description": "Fetch PROSITE pattern/profile details",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^PS\\d{5}$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "id"],
        "properties": {
          "accession": { "type": "string" },
          "id": { "type": "string" },
          "description": { "type": "string" },
          "pattern": { "type": ["string", "null"] },
          "documentation": { "type": "string" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "phosphosite_modifications",
      "description": "Search PhosphoSitePlus modifications",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gene": { "type": ["string", "null"] },
          "uniprot_acc": { "type": ["string", "null"] },
          "modification_type": {
            "type": ["string", "null"],
            "enum": [null, "phosphorylation", "acetylation", "ubiquitination", "methylation"]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["modifications"],
        "properties": {
          "modifications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "protein": { "type": "string" },
                "gene": { "type": "string" },
                "residue": { "type": "string" },
                "position": { "type": "integer" },
                "modification": { "type": "string" },
                "organism": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [
        {
          "case": "empty_query",
          "expectedError": {
            "type": "ValueError",
            "message": "gene or uniprot_acc required"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1,
        "note": "PhosphoSitePlus: academic license required"
      }
    },
    {
      "name": "phosphosite_regulatory_sites",
      "description": "Fetch regulatory site information",
      "inputSchema": {
        "type": "object",
        "required": ["gene"],
        "properties": {
          "gene": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["sites"],
        "properties": {
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "site": { "type": "string" },
                "function": { "type": "string" },
                "process": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "elm_motifs",
      "description": "Search ELM linear motifs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": ["string", "null"] },
          "functional_class": { "type": ["string", "null"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["motifs"],
        "properties": {
          "motifs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "elm_identifier": { "type": "string" },
                "functional_site_name": { "type": "string" },
                "description": { "type": "string" },
                "regex": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "elm_get_motif",
      "description": "Fetch ELM motif details",
      "inputSchema": {
        "type": "object",
        "required": ["elm_id"],
        "properties": {
          "elm_id": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["elm_identifier"],
        "properties": {
          "elm_identifier": { "type": "string" },
          "functional_site_name": { "type": "string" },
          "description": { "type": "string" },
          "regex": { "type": "string" },
          "instances": { "type": "integer" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "expectedError": {
            "type": "NotFoundError"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    }
  ]
}
