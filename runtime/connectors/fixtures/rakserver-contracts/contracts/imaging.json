{
  "domain": "imaging",
  "version": "1.0.0",
  "description": "Bioimaging data repositories: BioImage Archive, IDR, OMERO, Cell Image Library",
  "tools": [
    {
      "name": "bia_search_images",
      "description": "Search for images in BioImage Archive",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["images"],
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["image_id", "title"],
              "properties": {
                "image_id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "accession": { "type": "string" },
                "organism": { "type": "string" },
                "imaging_type": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "bia_get_image",
      "description": "Fetch detailed metadata for a specific image from BioImage Archive",
      "inputSchema": {
        "type": "object",
        "required": ["image_id"],
        "properties": {
          "image_id": {
            "type": "string",
            "description": "BioImage Archive image identifier"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["image_id"],
        "properties": {
          "image_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "accession": { "type": "string" },
          "organism": { "type": "string" },
          "imaging_type": { "type": "string" },
          "file_list": { "type": "array" },
          "release_date": { "type": "string" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "condition": "Image ID does not exist",
          "expectedError": {
            "type": "NotFoundError",
            "message": "Image not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "idr_search_studies",
      "description": "Search for imaging studies in Image Data Resource",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["studies"],
        "properties": {
          "studies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["study_id", "title"],
              "properties": {
                "study_id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "authors": { "type": "string" },
                "organism": { "type": "string" },
                "imaging_method": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "idr_get_study",
      "description": "Fetch detailed metadata for a specific study from Image Data Resource",
      "inputSchema": {
        "type": "object",
        "required": ["study_id"],
        "properties": {
          "study_id": {
            "type": "string",
            "description": "IDR study identifier"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["study_id"],
        "properties": {
          "study_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "authors": { "type": "string" },
          "organism": { "type": "string" },
          "imaging_method": { "type": "string" },
          "publication_doi": { "type": "string" },
          "image_count": { "type": "integer" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "condition": "Study ID does not exist",
          "expectedError": {
            "type": "NotFoundError",
            "message": "Study not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "omero_search_images",
      "description": "Search for images in OMERO server",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["images"],
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["image_id", "name"],
              "properties": {
                "image_id": { "type": "integer" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "acquisition_date": { "type": "string" },
                "dimensions": { "type": "string" },
                "pixel_size": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "omero_get_image",
      "description": "Fetch detailed metadata for a specific image from OMERO",
      "inputSchema": {
        "type": "object",
        "required": ["image_id"],
        "properties": {
          "image_id": {
            "type": "integer",
            "description": "OMERO image identifier"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["image_id"],
        "properties": {
          "image_id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "acquisition_date": { "type": "string" },
          "dimensions": { "type": "string" },
          "pixel_size": { "type": "string" },
          "channels": { "type": "array" },
          "z_sections": { "type": "integer" },
          "time_points": { "type": "integer" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "condition": "Image ID does not exist",
          "expectedError": {
            "type": "NotFoundError",
            "message": "Image not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "cell_image_library_search",
      "description": "Search for images in Cell Image Library",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["images"],
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["accession", "name"],
              "properties": {
                "accession": { "type": "string", "pattern": "^CIL:\\d+$" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "organism": { "type": "string" },
                "cell_type": { "type": "string" },
                "imaging_mode": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    },
    {
      "name": "cell_image_library_get",
      "description": "Fetch detailed metadata for a specific image from Cell Image Library",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": {
            "type": "string",
            "pattern": "^CIL:\\d+$",
            "description": "Cell Image Library accession number (e.g., CIL:12345)"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^CIL:\\d+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "organism": { "type": "string" },
          "cell_type": { "type": "string" },
          "imaging_mode": { "type": "string" },
          "cellular_component": { "type": "string" },
          "biological_process": { "type": "string" },
          "attribution": { "type": "string" }
        }
      },
      "errorCases": [
        {
          "case": "not_found",
          "condition": "Accession does not exist",
          "expectedError": {
            "type": "NotFoundError",
            "message": "Accession not found"
          }
        }
      ],
      "rateLimits": {
        "requestsPerSecond": 1
      }
    }
  ]
}
