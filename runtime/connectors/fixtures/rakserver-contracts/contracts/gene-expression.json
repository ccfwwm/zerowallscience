{
  "domain": "gene-expression",
  "version": "1.0.0",
  "description": "GTEx, GEO, ArrayExpress expression data contracts",
  "tools": [
    {
      "name": "gtex_expression_by_gene",
      "description": "Fetch GTEx expression for gene across tissues",
      "inputSchema": {
        "type": "object",
        "required": ["gene_id"],
        "properties": {
          "gene_id": { "type": "string" },
          "dataset": { "type": "string", "default": "gtex_v8" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["gene", "tissues"],
        "properties": {
          "gene": { "type": "string" },
          "tissues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tissue": { "type": "string" },
                "median_tpm": { "type": "number" }
              }
            }
          }
        }
      },
      "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "gtex_expression_by_tissue",
      "description": "Fetch expression for tissue across genes",
      "inputSchema": {
        "type": "object",
        "required": ["tissue"],
        "properties": {
          "tissue": { "type": "string" },
          "gene_list": { "type": "array", "items": { "type": "string" }}
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["tissue", "genes"],
        "properties": {
          "tissue": { "type": "string" },
          "genes": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "gtex_eqtls",
      "description": "Fetch GTEx eQTL data",
      "inputSchema": {
        "type": "object",
        "required": ["gene_id", "tissue"],
        "properties": {
          "gene_id": { "type": "string" },
          "tissue": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["eqtls"],
        "properties": {
          "eqtls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variant_id": { "type": "string" },
                "pvalue": { "type": "number" },
                "slope": { "type": "number" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "geo_search_datasets",
      "description": "Search GEO datasets",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "max_records": { "type": "integer", "default": 20 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accession": { "type": "string" },
                "title": { "type": "string" },
                "organism": { "type": "string" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 3}
    },
    {
      "name": "geo_get_dataset",
      "description": "Fetch GEO dataset metadata",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^GDS\\d+$|^GSE\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "title"],
        "properties": {
          "accession": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "organism": { "type": "string" },
          "sample_count": { "type": "integer" }
        }
      },
      "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}],
      "rateLimits": {"requestsPerSecond": 3}
    },
    {
      "name": "arrayexpress_search_experiments",
      "description": "Search ArrayExpress experiments",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": ["string", "null"] },
          "organism": { "type": ["string", "null"] },
          "exptype": { "type": ["string", "null"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["experiments"],
        "properties": {
          "experiments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accession": { "type": "string" },
                "name": { "type": "string" },
                "organism": { "type": "array" }
              }
            }
          }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "arrayexpress_get_experiment",
      "description": "Fetch ArrayExpress experiment details",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^E-[A-Z]+-\\d+$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "name"],
        "properties": {
          "accession": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "samples": { "type": "integer" }
        }
      },
      "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "encode_search_experiments",
      "description": "Search ENCODE experiments",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assay": { "type": ["string", "null"] },
          "target": { "type": ["string", "null"] },
          "biosample": { "type": ["string", "null"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["experiments"],
        "properties": {
          "experiments": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "encode_get_file",
      "description": "Fetch ENCODE file metadata",
      "inputSchema": {
        "type": "object",
        "required": ["accession"],
        "properties": {
          "accession": { "type": "string", "pattern": "^ENCFF[A-Z0-9]{6}$" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["accession", "file_format"],
        "properties": {
          "accession": { "type": "string" },
          "file_format": { "type": "string" },
          "file_size": { "type": "integer" },
          "href": { "type": "string" }
        }
      },
      "errorCases": [{"case": "not_found", "expectedError": {"type": "NotFoundError"}}],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "protein_atlas_expression",
      "description": "Fetch Human Protein Atlas expression",
      "inputSchema": {
        "type": "object",
        "required": ["gene"],
        "properties": {
          "gene": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["gene", "tissues"],
        "properties": {
          "gene": { "type": "string" },
          "tissues": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "protein_atlas_pathology",
      "description": "Fetch HPA pathology data",
      "inputSchema": {
        "type": "object",
        "required": ["gene"],
        "properties": {
          "gene": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["gene", "cancers"],
        "properties": {
          "gene": { "type": "string" },
          "cancers": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "protein_atlas_immunohistochemistry",
      "description": "Fetch HPA IHC images",
      "inputSchema": {
        "type": "object",
        "required": ["gene"],
        "properties": {
          "gene": { "type": "string" },
          "tissue": { "type": ["string", "null"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["gene", "images"],
        "properties": {
          "gene": { "type": "string" },
          "images": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "panglaodb_markers",
      "description": "Search PanglaoDB cell type markers",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cell_type": { "type": ["string", "null"] },
          "gene": { "type": ["string", "null"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["markers"],
        "properties": {
          "markers": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "cellxgene_census_datasets",
      "description": "List CELLxGENE census datasets",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organism": { "type": "string", "default": "Homo sapiens" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["datasets"],
        "properties": {
          "datasets": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    },
    {
      "name": "cellxgene_query_cells",
      "description": "Query CELLxGENE census cells",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cell_type": { "type": ["string", "null"] },
          "tissue": { "type": ["string", "null"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["cells"],
        "properties": {
          "cells": { "type": "array" }
        }
      },
      "errorCases": [],
      "rateLimits": {"requestsPerSecond": 1}
    }
  ]
}
