{
  "name": "@zerowall/dsh-plugin-brand-ui",
  "version": "0.1.0",
  "description": "ZeroWall Science sidebar branding and adaptive theme for DSH",
  "keywords": [
    "dsh-plugin",
    "branding",
    "theme",
    "zerowall-science"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ZeroWall Science",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccfwwm/zerowall-dsh-plugin-brand-ui.git"
  },
  "homepage": "https://github.com/ccfwwm/zerowall-dsh-plugin-brand-ui",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "migration-reference.md",
    "locale/*.json",
    "plugin-detail.md",
    "plugin-detail.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "react",
        "react-dom"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:release": "npm run check && npm run test:package",
    "prepublishOnly": "npm run check && npm run test:package"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^6.0.3",
    "esbuild": "^0.25.0",
    "vitest": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  }
}
