{
  "name": "@zerowall/dsh-plugin-python",
  "version": "0.1.0-preview.6",
  "description": "ZeroWall Science python domain plugin.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/shared/types.d.ts",
      "default": "./lib/types.js"
    },
    "./manifest": "./zerowall.plugin.json",
    "./package.json": "./package.json",
    "./runtime-path": {
      "types": "./lib/types/shared/runtime-path.d.ts",
      "default": "./lib/runtime-path.js"
    },
    "./runtime-process": {
      "types": "./lib/types/shared/runtime-process.d.ts",
      "default": "./lib/runtime-process.js"
    },
    "./python-localization": {
      "types": "./lib/types/shared/python-localization.d.ts",
      "default": "./lib/python-localization.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client-api": {
      "types": "./lib/types/shared/browser-management.d.ts",
      "default": "./lib/client-api.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "zerowall": {
    "dsh": {
      "min": "0.2.2-rc.1",
      "max": "0.2.2-rc.1"
    },
    "requiredServices": [
      "tools"
    ],
    "optionalServices": [],
    "capabilities": [
      "python"
    ],
    "permissions": [
      "processes",
      "files"
    ],
    "profiles": [
      "development",
      "preview",
      "stable"
    ],
    "migrationVersion": 1,
    "restartRequired": true,
    "rollbackSupported": true,
    "build": {
      "host": "src/host/index.ts",
      "client": "src/client/index.ts",
      "shared": {
        "runtime-path": "src/shared/runtime-path.ts",
        "runtime-process": "src/shared/runtime-process.ts",
        "python-localization": "src/shared/python-localization.ts",
        "types": "src/shared/types.ts",
        "client-api": "src/shared/browser-management.ts"
      }
    },
    "asarUnpack": true,
    "runtimeFiles": [
      "lib/index.js",
      "resources/runtime/runtime.json",
      "resources/runtime/core.lock",
      "resources/runtime/uv.exe",
      "resources/runtime/ocr-v5.json"
    ]
  },
  "scripts": {
    "prepack": "pnpm run build",
    "bundle": "node ../../scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/build-plugin.mjs",
    "prepare:runtime": "node ../../scripts/prepare-python-runtime.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "lib",
    "dsh.bundle.patch.yml",
    "zerowall.plugin.json",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "migration-reference.md",
    "locale/*.json",
    "plugin-detail.md",
    "plugin-detail.zh.md",
    "resources/runtime/runtime.json",
    "resources/runtime/core.lock",
    "resources/runtime/core.in",
    "resources/runtime/base-constraints.txt",
    "resources/runtime/uv.exe",
    "resources/runtime/uv",
    "resources/runtime/licenses",
    "resources/runtime/ocr-v5.json"
  ],
  "dependencies": {
    "@zerowall/integrity-runtime": "^0.1.0-preview.1",
    "@zerowall/research-store": "^0.1.0-preview.1",
    "yauzl": "3.4.0",
    "pend": "1.2.0",
    "react-dom": "^18.2.0",
    "@zerowall/dsh-plugin-environment": "0.1.0-preview.7",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1"
