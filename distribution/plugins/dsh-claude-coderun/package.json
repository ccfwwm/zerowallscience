{
  "name": "@zerowall/dsh-claude-coderun",
  "version": "0.1.0",
  "description": "Run an isolated Claude Code CLI from ZeroWall conversations.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/shared/types.d.ts",
      "default": "./lib/types.js"
    },
    "./manifest": "./zerowall.plugin.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "zerowall": {
    "dsh": {
      "min": "0.2.2-rc.1",
      "max": "0.2.2-rc.1"
    },
    "requiredServices": [
      "agentDefaultModel",
      "subprocess",
      "subagents",
      "workingDirectory",
      "skills",
      "zerowallMcpConfigurationStore",
      "zerowallEnvironment",
      "credentials",
      "settings",
      "llm",
      "sessionProjections",
      "agentPresets",
      "tools",
      "systemPrompt",
      "permissionPresets",
      "approval",
      "attachments"
    ],
    "optionalServices": [
      "zerowallAiCloudCredentialResolver",
      "zerowallMcpRouteResolver",
      "zerowallMcp",
      "zerowallCapabilities",
      "agents",
      "subagentModelSelection"
    ],
    "capabilities": [
      "claude-code"
    ],
    "permissions": [
      "processes",
      "files",
      "network",
      "credentials",
      "approvals",
      "attachments"
    ],
    "profiles": [
      "development",
      "stable"
    ],
    "migrationVersion": 1,
    "restartRequired": true,
    "rollbackSupported": true,
    "build": {
      "host": "src/host/index.ts",
      "client": "src/client/index.ts",
      "shared": {
        "types": "src/shared/types.ts"
      }
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "bundle": "node ../../scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/build-plugin.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "files": [
    "lib",
    "LICENSE",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "dsh.bundle.patch.yml",
    "zerowall.plugin.json",
    "README.md",
    "README.zh.md",
    "migration-reference.md",
    "locale/*.json",
    "plugin-detail.md",
    "plugin-detail.zh.md"
  ],
  "dependencies": {
    "@zerowall/dsh-plugin-mcp": "0.1.0",
    "@zerowall/dsh-plugin-environment": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react-dom": "^18.2.0",
    "zod": "4.4.3",
    "@zerowall/dsh-plugin-ai-cloud": "0.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.263"
  },
