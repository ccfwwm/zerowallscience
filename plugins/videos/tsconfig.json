{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@zerowallscience/plugin-*/types": [
        "../../plugins/*/src/shared/types.ts"
      ],
      "@zerowallscience/plugin-*": [
        "../../plugins/*/src/host/index.ts"
      ]
    },
    "composite": false
  },
  "include": [
    "src"
  ]
}
