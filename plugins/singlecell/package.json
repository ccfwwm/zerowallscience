{
  "name": "@zerowallscience/plugin-singlecell",
  "version": "0.1.0",
  "description": "ZeroWall Science singlecell domain plugin (desktop 8.0.0).",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/host/index.ts",
  "exports": {
    ".": {
      "types": "./src/host/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": "./src/shared/types.ts",
    "./manifest": "./zerowall.plugin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "betterSidebar",
        "slots",
        "uiConversation",
        "settingsScope",
        "conversation",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "zerowall": {
    "desktop": {
      "min": "8.0.0"
    },
    "dsh": {
      "min": "0.2.0-rc.2",
      "max": "0.2.0-rc.2"
    },
    "requiredServices": [
      "tools",
      "sessions"
    ],
    "optionalServices": [
      "zerowallFiles",
      "zerowallProjects",
      "zerowallResearch",
      "zerowallRuns",
      "webServer"
    ],
    "capabilities": [
      "singlecell-analysis",
      "public-data-acquisition",
      "scTenifoldKnk",
      "analysis-workflow"
    ],
    "permissions": [
      "files",
      "network",
      "attachments",
      "processes",
      "approvals"
    ],
    "profiles": [
      "development",
      "preview",
      "stable"
    ],
    "migrationVersion": 1,
    "restartRequired": true,
    "rollbackSupported": true
  },
  "scripts": {
    "prepack": "node ../../tools/plugins/prepare-pack.mjs",
    "bundle": "tsdown",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --config ../../vitest.plugins.config.ts"
  },
  "publishConfig": {
    "directory": "../../artifacts/dev/publish/plugin-singlecell"
  },
  "license": "AGPL-3.0-only",
  "files": [
    "lib",
    "src",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "dsh.bundle.patch.yml",
    "zerowall.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "dsh-better-sidebar": "workspace:^",
    "dsh-dream-skin": "9.29.0",
    "@zerowallscience/plugin-base": "workspace:^",
    "@zerowallscience/plugin-files": "workspace:^",
    "@zerowallscience/plugin-projects": "workspace:^",
    "@zerowallscience/plugin-research": "workspace:^",
    "@zerowallscience/plugin-runs": "workspace:^",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
