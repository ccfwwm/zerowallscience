{
  "name": "@zerowallscience/plugin-claude-code",
  "version": "0.2.15",
  "description": "Run an isolated Claude Code CLI from ZeroWall conversations.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/host/index.ts",
  "exports": {
    ".": {
      "types": "./src/host/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": "./src/shared/types.ts",
    "./manifest": "./zerowall.plugin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale",
        "uiConversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "zerowall": {
    "desktop": {
      "min": "8.4.7"
    },
    "dsh": {
      "min": "0.2.1-rc.2",
      "max": "0.2.1-rc.2"
    },
    "requiredServices": [
      "agentDefaultModel",
      "subprocess",
      "subagents",
      "workingDirectory",
      "skills",
      "zerowallMcpConfigurationStore",
      "zerowallEnvironment",
      "credentials",
      "settings",
      "llm",
      "sessionProjections",
      "agentPresets",
      "tools",
      "systemPrompt",
      "permissionPresets",
      "approval",
      "attachments"
    ],
    "optionalServices": [
      "zerowallAiCloudCredentialResolver",
      "zerowallMcpRouteResolver",
      "zerowallMcp",
      "zerowallCapabilities",
      "agents",
      "subagentModelSelection"
    ],
    "capabilities": [
      "claude-code"
    ],
    "permissions": [
      "processes",
      "files",
      "network",
      "credentials",
      "approvals",
      "attachments"
    ],
    "profiles": [
      "development",
      "preview",
      "stable"
    ],
    "migrationVersion": 1,
    "restartRequired": true,
    "rollbackSupported": true
  },
  "scripts": {
    "prepack": "node ../../tools/plugins/prepare-pack.mjs",
    "bundle": "tsdown",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --config ../../vitest.plugins.config.ts"
  },
  "publishConfig": {
    "directory": "../../artifacts/dev/publish/plugin-claude-code",
    "linkDirectory": false
  },
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "LICENSE",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "dsh.bundle.patch.yml",
    "zerowall.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "@zerowallscience/plugin-base": "^0.1.24",
    "@zerowallscience/plugin-mcp": "workspace:^",
    "@zerowallscience/plugin-secrets": "workspace:^",
