{
  "name": "@oh-story/dsh",
  "version": "0.1.16-zws.20",
  "description": "通过对话创作视频、音乐和宣传片，图片仅作为视频参考素材",
  "keywords": [
    "dsh-plugin",
    "media-creation",
    "video",
    "music",
    "promotion-video"
  ],
  "homepage": "https://github.com/zenstory-ai/oh-story-dsh#readme",
  "bugs": "https://github.com/zenstory-ai/oh-story-dsh/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenstory-ai/oh-story-dsh.git",
    "directory": "packages/dsh-plugin"
  },
  "publishConfig": {
    "directory": "../../artifacts/dev/publish/oh-story-dsh"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-typert-protocol",
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*",
    "LICENSE",
    "README.md",
    "README.upstream.md",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "bundle": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.oh-story.config.ts",
    "prepack": "node ../../tools/plugins/prepare-pack.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/schemastery": "^3.18.4 || ^3.18.5-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.2.1-0",
    "dsh-better-sidebar": ">=0.25.0 <0.27.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.2.1-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-typert-registry": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.9.3",
    "zod": "4.4.3",
    "@types/node": "24.10.1",
    "tsx": "^4.22.4",
    "vitest": "^4.0.18",
    "esbuild": "0.25.0",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@zerowallscience/plugin-ai-cloud": "^0.1.15",
    "@zerowallscience/plugin-python": "^0.1.10",
    "@zerowallscience/plugin-secrets": "workspace:^",
    "@zerowallscience/plugin-environment": "workspace:^"
  },
  "zerowall": {
    "desktop": {
      "min": "8.1.3"
    },
    "dsh": {
      "min": "0.2.0-rc.2",
      "max": "0.2.0-rc.2"
    },
    "requiredServices": [
      "skills",
      "tools",
      "typert",
      "webServer",
      "zerowallMedia",
      "zerowallMediaJobs",
      "zerowallPython",
      "zerowallEnvironment",
      "attachments",
      "connection"
    ],
    "capabilities": [
      "media.create",
      "media.edit",
      "media.compose"
    ],
    "permissions": [
      "files",
      "network",
      "processes",
      "credentials",
      "approvals"
    ],
    "restartRequired": true,
    "rollbackSupported": true
  }
}
