{
  "name": "@zerowallscience/plugin-wechat",
  "version": "5.0.2",
  "dsh": {
    "min": "0.1.2-alpha.5",
    "max": "0.1.2-alpha.5"
  },
  "host": "./lib/index.js",
  "client": "./lib/client.js",
  "requiredServices": [
    "agents",
    "sessions",
    "agentDefaultModel"
  ],
  "optionalServices": [
    "webServer",
    "workspaceRegistry",
    "agentPresets"
  ],
  "capabilities": [
    "remote.wechat"
  ],
  "permissions": [
    "credentials",
    "network",
    "files",
    "approvals"
  ],
  "network": true,
  "files": true,
  "credentials": true,
  "approvals": true,
  "profiles": [
    "development",
    "preview",
    "stable"
  ],
  "migrationVersion": 1
}
