{
  "schema": 1,
  "version": "8.3.0",
  "roles": {
    "dsh": {
      "independentInstall": true,
      "description": "兼容 DSH 的独立插件；保持原 npm name，并登记上游来源。"
    },
    "support": {
      "independentInstall": false,
      "description": "ZeroWall 构建和完整性支持库；不作为领域插件安装。"
    },
    "bundles": {
      "independentInstall": false,
      "description": "组合声明，只声明组成关系，不复制插件代码。"
    }
  },
  "packages": {
    "dsh-bundle-core": {
      "role": "bundles",
      "composition": [
        "@zerowallscience/plugin-base",
        "@zerowallscience/plugin-secrets",
        "@zerowallscience/plugin-environment",
        "@zerowallscience/plugin-desktop-compat",
        "@zerowallscience/plugin-extension-center"
      ]
    },
    "dsh-bundle-science": {
      "role": "bundles",
      "compositionSource": "plugins/dsh-bundle-science/package.json"
    }
  },
  "migration": {
    "readLegacy": false,
    "writeCanonical": true,
    "deleteLegacy": true
  }
}
