{
  "schema": 1,
  "defaults": {
    "dryRun": true,
    "stageDays": 14,
    "devDays": 14,
    "failedBuildDays": 7,
    "cacheDays": 30,
    "logsDays": 90,
    "objectDays": 1,
    "keepDesktopVersions": 1,
    "keepResourceVersions": 2,
    "keepStagesPerVersion": 1,
    "keepRuntimeAssembliesPerKind": 1,
    "keepOfflineCarriers": 1,
    "keepResourceTrees": 1
  },
  "protectedRoots": [
    "deepseek-harness",
    "node_modules",
    "desktop/node_modules",
    "desktop/build",
    "scripts/env",
    ".zerowall",
    "artifacts/stage/current.json",
    "artifacts/release",
    "%SystemDrive%"
  ],
  "managedRoots": [
    "artifacts/stage",
    "artifacts/packages",
    "artifacts/verification",
    "artifacts/dev",
    "artifacts/cache/legacy-outputs",
    "artifacts/cache/electron-builder",
    "artifacts/cache/runtime-assemblies",
    "artifacts/cache/offline-carriers",
    "artifacts/cache/resource-trees",
    "artifacts/logs",
    "artifacts/objects"
  ],
  "neverDelete": [
    "artifacts/release/**/publication/**",
    "artifacts/release/**/catalogs/**",
    "artifacts/release/**/immutable-*-receipt.json",
    "artifacts/release/**/artifact-manifest.json"
  ]
}
