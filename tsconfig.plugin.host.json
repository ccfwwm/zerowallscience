{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "../..",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@zerowallscience/research-store": ["store/src/index.ts"],
      "@zerowallscience/research-store/types": ["store/src/index.ts"],
      "@zerowallscience/plugin-*/types": ["plugins/*/src/shared/types.ts"],
      "@zerowallscience/plugin-*": ["plugins/*/src/host/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "noEmit": true
  }
}
