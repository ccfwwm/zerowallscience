{
  "name": "@michengai/dsh-archive-manager",
  "version": "1.0.17-zws.1",
  "description": "归档、恢复、收藏和永久删除会话，并诊断损坏的会话日志。 · Archive, restore, favorite, and permanently delete sessions, and diagnose damaged session logs.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./workspace": "./lib/workspace.js",
    "./projcache": "./lib/projcache.js",
    "./host": "./lib/host-install.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "README.zerowall.zh-CN.md"
  ],
  "scripts": {
    "build": "pnpm typecheck && node scripts/build.mjs",
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/archive-discovery.test.mjs test/archive-experience.test.mjs test/archive-organizer.test.mjs test/host-install.test.mjs test/host.test.mjs test/projcache-overlay.test.mjs test/session-repair.test.mjs test/workspace-composition.test.mjs test/zerowall-update.test.mjs test/plugin-disable.test.mjs test/client.test.mjs test/client-remote.test.mjs test/archive-discovery-ui.test.mjs test/archive-organizer-ui.test.mjs test/archive-settings-section.test.mjs test/theme-i18n.test.mjs"
  },
