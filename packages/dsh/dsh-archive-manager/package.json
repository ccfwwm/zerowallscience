  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichengAI/dsh-archive-manager.git"
  },
  "homepage": "https://github.com/MichengAI/dsh-archive-manager#readme",
  "bugs": {
    "url": "https://github.com/MichengAI/dsh-archive-manager/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "archive",
    "session-management",
    "cordis",
    "typert",
    "workspace",
    "nodejs",
    "esm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "zerowall": {
    "desktop": {
      "min": "8.1.3"
    },
    "dsh": {
      "min": "0.2.0-rc.2",
      "max": "0.2.0-rc.2"
    },
    "capabilities": [
      "session-archive",
      "session-restore",
      "session-favorites",
      "session-diagnostics",
      "session-delete"
    ],
    "permissions": [
      "files"
    ],
    "restartRequired": true,
    "rollbackSupported": true
  }
