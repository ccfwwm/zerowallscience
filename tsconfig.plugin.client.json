{
  "extends": "./tsconfig.plugin.host.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "noCheck": true,
    "paths": {
      "@zerowallscience/research-store": ["store/src/index.ts"],
      "@zerowallscience/plugin-*/types": ["plugins/*/src/shared/types.ts"],
      "@zerowallscience/plugin-*/client": ["plugins/*/src/client/index.ts"],
      "@zerowallscience/plugin-*": ["plugins/*/src/host/index.ts"]
    }
  }
}
