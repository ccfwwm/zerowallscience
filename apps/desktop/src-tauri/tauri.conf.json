{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroWall Science",
  "version": "0.4.21",
  "identifier": "com.zerowall.science",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @zerowall/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @zerowall/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroWall Science",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/opencode",
      "binaries/uv",
      "binaries/agent-browser"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../runtime/goal-plugin": "goal-plugin/",
      "../../../runtime/skills/external/ai4s-skills": "skills/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/core": "skills-core/",
      "../../../runtime/skills/advanced": "skills-advanced/",
      "../../../runtime/skills/compute": "skills-compute/",
      "../../../runtime/skills/life-science": "skills-life-science/",
      "../../../runtime/skills/literature": "skills-literature/",
      "../../../runtime/skills/publishing": "skills-publishing/",
      "../../../runtime/harness": "harness/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "ZeroWall Science",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "English": "nsis/en.nsh",
          "SimpChinese": "nsis/zh-Hans.nsh"
        }
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
