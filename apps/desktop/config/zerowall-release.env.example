# Copy to apps/desktop/config/publishing/.env.qiniu (the default) or set ZEROWALL_QINIU_ENV_FILE.
# Store the filled copy outside Git. Relative resource-key paths resolve beside the selected file.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=
QINIU_DOMAIN=
DSH_DESKTOP_WINDOWS_CER_FILE=C:/private/zerowall-public.cer
DSH_DESKTOP_UPDATE_CHANNEL=nightly
DSH_DESKTOP_AUTO_UPDATE_ENV=test
ZEROWALL_RESOURCE_PRIVATE_KEY_FILE=resource-stable-4-private.pem
ZEROWALL_RESOURCE_KEY_ID=stable-4
